#!/bin/bash -e
#
# Mantis: Autonomous UDMI Agent & Diagnostic Management Control Plane
#
# Usage:
#   bin/mantis                     # Interactive Diagnostic Session
#   bin/mantis "<instruction>"     # Headless universal execution
#   bin/mantis <bundle.zip>        # Support bundle triage
#   bin/mantis --mcp               # Run stdio Model Context Protocol (MCP) server
#

ROOT_DIR=$(realpath $(dirname $0)/..)
cd "$ROOT_DIR"

# 1. Self-Bootstrapping: Detect and configure virtual environment
if [ ! -f "venv/bin/activate" ] || [ ! -x "venv/bin/python3" ]; then
    echo "Initializing Mantis runtime environment (bin/setup_base)..."
    bin/setup_base
fi

source venv/bin/activate

# 2. Verify tmux availability for session isolation
if ! command -v tmux >/dev/null 2>&1; then
    echo "Warning: tmux is not installed or not in PATH. Local session management requires tmux." >&2
fi

export PYTHONPATH="$ROOT_DIR:${PYTHONPATH:-}"

exec python3 -m mantis.cli "$@"
