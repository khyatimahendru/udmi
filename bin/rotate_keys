#!/bin/bash -e

# Usage: bin/rotate_keys <site_path> <project_spec> <device_id> [key_format]

source $(dirname $0)/../etc/shell_common.sh

if [[ $# -lt 3 ]]; then
    echo "Usage: $0 <site_path> <project_spec> <device_id> [key_format]"
    echo "  key_format defaults to RS256 (options: RS256, ES256)"
    exit 1
fi

SITE_PATH=$1
PROJECT_SPEC=$2
DEVICE_ID=$3
KEY_FORMAT=${4:-RS256}

DEVICE_DIR="$SITE_PATH/devices/$DEVICE_ID"
if [[ ! -d "$DEVICE_DIR" ]]; then
    echo "Error: Device directory $DEVICE_DIR does not exist"
    exit 1
fi

echo "============================================================"
echo "Starting automated key rotation for device: $DEVICE_ID"
echo "Target Project: $PROJECT_SPEC"
echo "Key Format: $KEY_FORMAT"
echo "============================================================"

# 1. Generate new temporary keypair
TEMP_KEY_DIR=$(mktemp -d)
trap "rm -rf $TEMP_KEY_DIR" EXIT

echo "Generating new $KEY_FORMAT keypair..."
$UDMI_ROOT/bin/keygen $KEY_FORMAT $TEMP_KEY_DIR > /dev/null

NEW_PUB_KEY=$(cat $TEMP_KEY_DIR/*_public.pem)
NEW_PRIV_KEY_B64=$(base64 -w 0 $TEMP_KEY_DIR/*_private.pkcs8)

# 2. Create rotation payload and trigger update using bin/update_blob
ROTATION_PAYLOAD=$(jq -nc \
  --arg kf "$KEY_FORMAT" \
  --arg kd "$NEW_PRIV_KEY_B64" \
  '{key_format: $kf, key_data: $kd}')

echo "Triggering device rotation via bin/update_blob (_iot_endpoint_credentials)..."
$UDMI_ROOT/bin/update_blob "$SITE_PATH" "$PROJECT_SPEC" "$DEVICE_ID" "_iot_endpoint_credentials" "$ROTATION_PAYLOAD"

# 3. Backup old keys and install new keys on disk
TIMESTAMP=$(date +%s)
for f in $DEVICE_DIR/*_private.pem $DEVICE_DIR/*_private.pkcs8 $DEVICE_DIR/*_public.pem; do
    if [[ -f "$f" ]]; then
        cp "$f" "$f.$TIMESTAMP.bak"
    fi
done

cp $TEMP_KEY_DIR/*_private.pem $DEVICE_DIR/
cp $TEMP_KEY_DIR/*_private.pkcs8 $DEVICE_DIR/
cp $TEMP_KEY_DIR/*_public.pem $DEVICE_DIR/

echo "Key rotation completed successfully for $DEVICE_ID."
